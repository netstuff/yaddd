# Every setting of infrastructure/config/settings.py, with its default.
# Copy to `.env` and adjust. The `YADDD_` prefix is part of every name.

# --- process identity -------------------------------------------------------
YADDD_APP_NAME=yaddd-template
# one of: local | test | staging | production
YADDD_APP_ENV=local
YADDD_LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
# Any async SQLAlchemy URL. Examples:
#   sqlite+aiosqlite:///./yaddd-template.db
#   postgresql+asyncpg://user:password@localhost:5432/yaddd
YADDD_DATABASE_URL=sqlite+aiosqlite:///./yaddd-template.db
YADDD_DB_ECHO=false

# --- broker -----------------------------------------------------------------
# Any FastStream URL: redis://, nats://, kafka://, rabbitmq:// …
YADDD_BROKER_URL=redis://localhost:6379/0
YADDD_BROKER_EVENTS_CHANNEL=domain-events

# --- bind addresses ---------------------------------------------------------
YADDD_API_HOST=0.0.0.0
YADDD_API_PORT=8000
YADDD_API_WORKERS=1
YADDD_WORKER_HOST=0.0.0.0
YADDD_WORKER_PORT=8001

# --- probes -----------------------------------------------------------------
# Per-check timeout in seconds; also bounds the aggregated readiness report.
YADDD_PROBE_TIMEOUT=2.0